# ==============================================================================
# Jarvis Assistant Configuration (Template)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Keys (Free Tier / Providers)
# ------------------------------------------------------------------------------
# Google Gemini API Key (for LLM reasoning, screen vision, and tool calling)
# Get a free key: https://aistudio.google.com (15 RPM, 1500 RPD)
GEMINI_API_KEY=""

# Groq API Key (for ultra-fast ~100ms Whisper Large v3 voice transcription)
# Get a free key: https://console.groq.com (20 RPM)
GROQ_API_KEY=""

# ------------------------------------------------------------------------------
# 2. Reasoning Model & Agent Engine
# ------------------------------------------------------------------------------
# Primary reasoning model. Jarvis features automatic multi-tier fallback if quotas are hit.
# Options: "gemini-3.5-flash-lite", "gemini-2.5-flash", "gemini-3.5-flash", "gemini-flash-latest"
JARVIS_MODEL="gemini-3.5-flash-lite"

# ------------------------------------------------------------------------------
# 3. CLI Coding & Autonomous Project Scaffolding Tool
# ------------------------------------------------------------------------------
# Preferred AI CLI tool used for project creation and code generation.
# Default option is "claude":
#   - "claude" : Anthropic Claude Code CLI (claude) [Default]
#   - "codex"  : OpenAI Codex CLI (codex)
#   - "agy"    : Google Antigravity CLI (agy)
JARVIS_CLI_AI_TOOL="claude"

# ------------------------------------------------------------------------------
# 4. Speech-to-Text (STT) Voice Recognition
# ------------------------------------------------------------------------------
# STT engine: "groq" (cloud ~100ms Whisper Large v3) or "local" (faster-whisper on-device)
JARVIS_STT_ENGINE="groq"

# Cloud Whisper model for Groq: "whisper-large-v3-turbo" or "whisper-large-v3"
JARVIS_WHISPER_MODEL="whisper-large-v3-turbo"

# Local Whisper model size (only used when JARVIS_STT_ENGINE="local"):
# Options: "tiny.en", "base.en", "small.en", "medium.en"
JARVIS_LOCAL_WHISPER_SIZE="base.en"

# ------------------------------------------------------------------------------
# 5. Text-to-Speech (TTS) Voice Synthesis
# ------------------------------------------------------------------------------
# TTS engine: "piper" (local fast neural voice) or "edge" (online Microsoft Edge TTS)
JARVIS_TTS_ENGINE="piper"

# Local Piper voice model name (stored in src/jarvis/audio/models/)
# Options: "en_GB-alan-medium", "en_US-lessac-medium"
JARVIS_VOICE="en_GB-alan-medium"

# ------------------------------------------------------------------------------
# 6. Audio Recording & Voice Activity Detection (VAD) Tuning
# ------------------------------------------------------------------------------
# Audio input sample rate (Hz)
JARVIS_SAMPLE_RATE=16000

# Audio channels (1 = mono, 2 = stereo)
JARVIS_CHANNELS=1

# Silence duration threshold in seconds before concluding speech
JARVIS_SILENCE_THRESHOLD=0.85

# Maximum recording duration in seconds before auto-submitting
JARVIS_MAX_RECORDING_SECONDS=20.0

# Timeout in seconds when waiting for initial speech after activation
JARVIS_INITIAL_LISTEN_TIMEOUT=8.0

# Timeout in seconds when waiting for follow-up speech in continuous conversation
JARVIS_FOLLOWUP_LISTEN_TIMEOUT=7.0

# ------------------------------------------------------------------------------
# 7. Wake Word Detection ("Hey Jarvis" / "Jarvis")
# ------------------------------------------------------------------------------
# Enable background wake word detection via openWakeWord
JARVIS_WAKEWORD_ENABLED=true

# Wake word model (pre-trained model in openWakeWord)
JARVIS_WAKEWORD_MODEL="hey_jarvis"

# Sensitivity threshold (0.0 to 1.0, recommended 0.28 for hands-free 'Hey Jarvis' and 'Jarvis')
JARVIS_WAKEWORD_THRESHOLD=0.28
